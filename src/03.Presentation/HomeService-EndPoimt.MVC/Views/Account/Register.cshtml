@model HomeService_EndPoimt.MVC.Models.Account.RegisterViewModel
@using Core_HomeService.Domain.Core.UserAgg.Enums

@{
    ViewData["Title"] = "ثبت‌نام";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-header">
        <span class="logo">SEE5</span>
        <h2>ایجاد حساب کاربری</h2>
    </div>

    <form asp-action="Register" method="post" class="auth-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <label asp-for="UserName">نام کاربری</label>
        <input asp-for="UserName" />

        <label asp-for="Password">رمز عبور</label>
        <input asp-for="Password" type="password" />

        <label asp-for="ConfirmPassword">تکرار رمز عبور</label>
        <input asp-for="ConfirmPassword" type="password" />

        <label asp-for="Role">نقش</label>
        <select asp-for="Role"
                asp-items="Html.GetEnumSelectList<UserRoleEnum>()">
        </select>

        <button type="submit" class="auth-button">ثبت‌نام</button>
    </form>

    <div class="auth-links">
        <a asp-action="Login">بازگشت به ورود</a>
    </div>
</div>
