@model HomeService_EndPoimt.MVC.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "ورود";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-header">
        <span class="logo">ورود به حساب کاربری</span>
    </div>

    <form asp-action="Login" method="post" class="auth-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <label asp-for="UserName">نام کاربری</label>
        <input asp-for="UserName" />

        <label asp-for="Password">رمز عبور</label>
        <input asp-for="Password" type="password" />

        <div class="auth-remember">
            <input asp-for="RememberMe" type="checkbox" />
            <label asp-for="RememberMe">مرا به خاطر بسپار</label>
        </div>

        <button type="submit" class="auth-button">ورود</button>
    </form>

    <div class="auth-links">
        <a asp-action="Register">ثبت‌نام</a>
    </div>
</div>
